generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String
  iconName    String   @default("HeartPulse")
  image       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  color       String   @default("from-teal-600/80 to-emerald-700/80")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ArchiveItem {
  id          String   @id @default(cuid())
  title       String
  description String
  date        String
  category    String
  image       String?
  color       String   @default("from-amber-600/70 to-orange-700/70")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

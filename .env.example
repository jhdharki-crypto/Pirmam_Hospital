# ========================================
# Pirmam Hospital - Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Database (Neon PostgreSQL)
# Get this from: https://console.neon.tech → Your Project → Connection Details
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Vercel Blob Storage (for image uploads)
# Get this from: https://vercel.com/dashboard → Your Project → Settings → Environment Variables
# Vercel sets this automatically when you enable Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
